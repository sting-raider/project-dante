# Project Dante — copy to .env and fill in. NEVER commit real secrets.

APP_ENV=development
DEMO_MODE=true

# Postgres (docker-compose maps host 5433 -> container 5432)
DATABASE_URL=postgresql+asyncpg://dante:dante@localhost:5433/dante
# Redis (docker-compose maps host 6380 -> container 6379)
REDIS_URL=redis://localhost:6380/0

# Persistence (JSON is the local/buildathon default; use a durable volume in
# production).  DANTE_STORE_PATH is restart-safe when set to a volume path.
DANTE_STORE_BACKEND=json
DANTE_STORE_PATH=.dante-store.json

# LLM provider: "anthropic" or "openai-compatible" enables LLM agents.
# "groq" is an alias for the OpenAI-compatible adapter, for example:
#   LLM_PROVIDER=groq
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=qwen/qwen3.8-27b
# Anything else runs the deterministic rule engine fallback (fully
# functional, honestly labeled).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
LLM_BASE_URL=

# Operator gate for the HYBRID demo (real Test Mode payment + synthetic
# fulfillment steps). While real Razorpay test keys are configured, every
# state-changing /api/demo/* call must send header
# X-Demo-Operator-Token: <this value>. Empty => those endpoints stay LOCKED.
# Ignored entirely when no Razorpay keys are set (pure-sandbox demo).
DEMO_OPERATOR_TOKEN=

# Razorpay TEST MODE credentials (dashboard -> Settings -> API Keys -> Test).
# If left empty, Dante runs against its built-in sandbox adapter which
# simulates Razorpay with realistic IDs and real HMAC signature flows,
# clearly badged SANDBOX in the UI. With keys set, every call is a real
# Razorpay Test Mode API call.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=dante-dev-webhook-secret

PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# -------------------------------------------------------------- DEPLOYMENT
# Railway (API) + Vercel (web). See docs/DEPLOYMENT.md for the full
# click-path. Names only — set real values in each platform's dashboard,
# never in this file.
#
#   API service (Railway): APP_ENV=production, DEMO_MODE,
#     RAZORPAY_KEY_ID [SECRET], RAZORPAY_KEY_SECRET [SECRET],
#     RAZORPAY_WEBHOOK_SECRET [SECRET], DEMO_OPERATOR_TOKEN [SECRET],
#     LLM_PROVIDER, LLM_MODEL, LLM_API_KEY [SECRET],
#     PUBLIC_APP_URL (Vercel web URL — CORS origin),
#     API_BASE_URL (this service's public URL)
#   Web app (Vercel): NEXT_PUBLIC_API_URL (public API URL; build-time
#     inlined), PUBLIC_APP_URL
#
# Single replica only (master plan §11.4): webhook dedupe and ordering live
# in the process-wide store; horizontal scaling would double-process events.
