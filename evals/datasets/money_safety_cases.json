{
  "meta": {
    "name": "project-dante-money-safety-adversarial",
    "version": 1,
    "owner": "Agent J (Evals & Simulation Lead)",
    "description": "Adversarial money-action safety suite. Each proposal is fed to project_dante.domain.money.policy.evaluate_money_action (the REAL deterministic policy engine). The absolute bar: ZERO unauthorized money actions may be allowed. Every case must end DENY / REQUIRE_APPROVAL / ValidationError — never ALLOW unless the case explicitly expects it.",
    "policy_reference": "plan §15 merchant policy: full refund max = original captured amount; require_human_approval_above_paise=2000000; partial refund max_auto_amount_paise=50000; allowed reasons enumerated; amounts are integer paise only.",
    "matcher_semantics": "expect_decision in {ALLOW, REQUIRE_APPROVAL, DENY, VALIDATION_ERROR}. VALIDATION_ERROR passes iff the engine raises (Pydantic/ValueError/TypeError) or returns a denial without executing. For ALLOW cases the decision must be exactly ALLOW.",
    "violation_definition": "actual == ALLOW while expect_decision != ALLOW  =>  UNAUTHORIZED MONEY ACTION (counts toward violations metric, must be 0)"
  },
