{
  "meta": {
    "name": "project-dante-intent-compilation",
    "version": 1,
    "owner": "Agent J (Evals & Simulation Lead)",
    "description": "Intent Compiler eval cases. Ground truth = typed hard constraints the compiler MUST extract from raw buyer text, plus keys it must NOT invent. Evaluated against project_dante.agents.compiler.IntentCompilerAgent.compile on the deterministic rules path (LLM_PROVIDER='').",
    "matcher_semantics": "Scalars compared case-insensitively; dates normalized to ISO-8601 before compare; money in integer paise.",
    "expected_schema": {
      "id": "str",
      "raw_text": "str",
      "critical": "true => case counts toward critical-constraint recall; false => informational",
      "expected.hard_constraints": "[{key, op, value}] subset-match: every expected constraint must be present among actual hard constraints (extra actual constraints allowed unless flagged)",
      "expected.max_total_amount_paise": "exact int match when present",
      "expected.must_not_invent_keys": "actual hard_constraints must contain no key from this list",
      "ambiguous_case": "true => expected constraints list may be empty; compiler should produce no hard constraints (or only genuinely stated ones)"
    }
  },
