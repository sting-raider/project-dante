{
  "meta": {
    "name": "project-dante-breach-detection",
    "version": 1,
    "owner": "Agent J (Evals & Simulation Lead)",
    "description": "Breach verification eval cases. Each case is a (promised, observed) pair fed through project_dante.domain.promises.verifier.evaluate_contract semantics: a material mismatch must be flagged with the expected severity and reason code; cosmetic/identical pairs must NOT breach.",
    "severity_vocabulary": ["informational", "minor", "material", "critical"],
    "matcher_semantics": "expect_severity compared exactly; expect_reason_code matched case-insensitively as substring of actual reason_code (so WARRANTY_MISMATCH matches warranty_type_mismatch); expect_breach=false cases pass iff no material-or-higher breach is produced for the pair."
  },
  "cases": [
    {
      "id": "BRC-001",
      "notes": "Hero failure path: UAE region variant delivered when India promised.",
      "promised": { "key": "terms.region", "value": "IN" },
      "observed": { "key": "terms.region", "value": "AE" },
      "material_to_intent": true,
      "expect_breach": true,
      "expect_severity": "material",
      "expect_reason_code": "REGION_MISMATCH"
    },
    {
      "id": "BRC-002",
      "notes": "Hero failure path companion: seller warranty where manufacturer promised.",
      "promised": { "key": "warranty.type", "value": "manufacturer" },
      "observed": { "key": "warranty.type", "value": "seller" },
      "material_to_intent": true,
      "expect_breach": true,
      "expect_severity": "material",
      "expect_reason_code": "WARRANTY_TYPE_MISMATCH"
    },
    {
      "id": "BRC-003",
      "notes": "Warranty region flip IN -> AE while type stays manufacturer.",
      "promised": { "key": "warranty.region", "value": "IN" },
      "observed": { "key": "warranty.region", "value": "AE" },
      "material_to_intent": true,
      "expect_breach": true,
      "expect_severity": "material",
      "expect_reason_code": "WARRANTY_REGION_MISMATCH"
    },
    {
      "id": "BRC-004",
      "notes": "Late delivery by ~3 days beyond promise: material SLA miss.",
      "promised": { "key": "delivery.delivered_at", "value": "2026-08-27" },
      "observed": { "key": "delivery.delivered_at", "value": "2026-08-30" },
      "material_to_intent": true,
      "expect_breach": true,
      "expect_severity": "material",
      "expect_reason_code": "DELIVERY_LATE"
    },
    {
      "id": "BRC-005",
      "notes": "Late delivery by ~2 hours past end-of-day: minor.",
      "promised": { "key": "delivery.delivered_at", "value": "2026-08-27T21:00:00+00:00" },
      "observed": { "key": "delivery.delivered_at", "value": "2026-08-27T23:02:00+00:00" },
      "material_to_intent": false,
      "expect_breach": true,
      "expect_severity": "minor",
      "expect_reason_code": "DELIVERY_LATE"
    },
    {
      "id": "BRC-006",
      "notes": "Missing low-value included accessory (USB cable): informational per merchant policy.",
      "promised": { "key": "accessories.included", "value": ["usb-c-cable", "carry-case"] },
      "observed": { "key": "accessories.included", "value": ["carry-case"] },
      "material_to_intent": false,
      "expect_breach": true,
      "expect_severity": "informational",
      "expect_reason_code": "ACCESSORY_MISSING"
    },
    {
      "id": "BRC-007",
      "notes": "Color variant differs but buyer never constrained color — cosmetic, no breach.",
      "promised": { "key": "variant.color", "value": "midnight-black" },
      "observed": { "key": "variant.color", "value": "arctic-white" },
      "material_to_intent": false,
      "color_was_material": false,
      "expect_breach": false
    },
    {
      "id": "BRC-008",
      "notes": "Identical region values: satisfied, no breach.",
      "promised": { "key": "terms.region", "value": "IN" },
      "observed": { "key": "terms.region", "value": "IN" },
      "expect_breach": false
    },
    {
      "id": "BRC-009",
      "notes": "Identical manufacturer warranty: satisfied.",
      "promised": { "key": "warranty.type", "value": "manufacturer" },
      "observed": { "key": "warranty.type", "value": "manufacturer" },
      "expect_breach": false
    },
    {
      "id": "BRC-010",
      "notes": "Delivery on or before promised date: no breach even if early.",
      "promised": { "key": "delivery.delivered_at", "value": "2026-08-27" },
      "observed": { "key": "delivery.delivered_at", "value": "2026-08-25" },
      "expect_breach": false
    },
    {
      "id": "BRC-011",
      "notes": "Wrong SKU delivered entirely: critical — buyer got a different product class.",
      "promised": { "key": "sku", "value": "AST-HP-ANC-001" },
