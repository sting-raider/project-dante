      "observed": { "key": "attributes.anc", "value": false },
      "material_to_intent": true,
      "expect_breach": true,
      "expect_severity": "material",
      "expect_reason_code": "FEATURE_MISSING"
    },
    {
      "id": "BRC-014",
      "notes": "US warranty region delivered instead of India.",
      "promised": { "key": "warranty.region", "value": "IN" },
      "observed": { "key": "warranty.region", "value": "US" },
      "material_to_intent": true,
      "expect_breach": true,
      "expect_severity": "material",
      "expect_reason_code": "WARRANTY_REGION_MISMATCH"
    },
    {
      "id": "BRC-015",
      "notes": "Delivery exactly ON the deadline timestamp boundary (same ISO day): no breach.",
      "promised": { "key": "delivery.delivered_at", "value": "2026-08-27T21:00:00+00:00" },
      "observed": { "key": "delivery.delivered_at", "value": "2026-08-27T20:59:30+00:00" },
      "expect_breach": false
    },
    {
      "id": "BRC-016",
      "notes": "Cosmetic packaging note difference in free-text notes field: informational at most, not material.",
      "promised": { "key": "offer.notes", "value": "Ships in recycled packaging" },
      "observed": { "key": "offer.notes", "value": "Ships in standard packaging" },
      "material_to_intent": false,
      "expect_breach": false
    },
    {
      "id": "BRC-017",
      "notes": "Warranty duration shorted 24 -> 12 months.",
      "promised": { "key": "warranty.duration_months", "value": 24 },
