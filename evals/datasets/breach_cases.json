      "expect_reason_code": "WARRANTY_DURATION_SHORTFALL"
    },
    {
      "id": "BRC-018",
      "notes": "Warranty duration longer than promised (12 -> 24): upgrade, never a breach.",
      "promised": { "key": "warranty.duration_months", "value": 12 },
      "observed": { "key": "warranty.duration_months", "value": 24 },
      "expect_breach": false
    },
    {
      "id": "BRC-019",
      "notes": "Late by one full day past a hard buyer deadline (Thursday -> Friday): material.",
      "promised": { "key": "delivery.delivered_at", "value": "2026-08-27T23:59:00+00:00" },
      "observed": { "key": "delivery.delivered_at", "value": "2026-08-28T23:59:00+00:00" },
      "material_to_intent": true,
      "expect_breach": true,
      "expect_severity": "material",
      "expect_reason_code": "DELIVERY_LATE"
    },
    {
      "id": "BRC-020",
      "notes": "Return window shorter than advertised: minor (post-purchase right reduced).",
      "promised": { "key": "returns.window_days", "value": 10 },
      "observed": { "key": "returns.window_days", "value": 7 },
      "material_to_intent": false,
      "expect_breach": true,
      "expect_severity": "minor",
      "expect_reason_code": "RETURN_WINDOW_SHORTFALL"
    },
    {
      "id": "BRC-021",
      "notes": "Return window longer than advertised: improvement, no breach.",
      "promised": { "key": "returns.window_days", "value": 7 },
      "observed": { "key": "returns.window_days", "value": 15 },
      "expect_breach": false
    },
    {
      "id": "BRC-022",
      "notes": "Region case-insensitive match (in vs IN normalization): no breach.",
      "promised": { "key": "terms.region", "value": "IN" },
      "observed": { "key": "terms.region", "value": "in" },
      "expect_breach": false
    },
    {
      "id": "BRC-023",
      "notes": "Both hero breaches together (region + warranty) — verifier must flag BOTH promises.",
      "multi": [
        {
          "promised": { "key": "terms.region", "value": "IN" },
          "observed": { "key": "terms.region", "value": "AE" }
        },
        {
          "promised": { "key": "warranty.type", "value": "manufacturer" },
          "observed": { "key": "warranty.type", "value": "seller" }
        }
      ],
      "material_to_intent": true,
